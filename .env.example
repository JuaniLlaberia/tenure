# Brain
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional: OpenRouter provider to try first (e.g. alibaba for DeepSeek); others serve models it lacks
OPENROUTER_PROVIDER=
MODEL_LEAD=deepseek/deepseek-v4-flash-0731
MODEL_SPECIALIST=deepseek/deepseek-v4-flash-0731
MODEL_REFLECT=deepseek/deepseek-v4-flash-0731
MODEL_CRITIC=anthropic/claude-sonnet-5.5
MODEL_DECIDE_FALLBACK=deepseek/deepseek-v4-flash-0731
MODEL_JEV=typesafe/jev-1.13
# Voice notes, photos and PDFs the founder sends (multimodal)
MODEL_MEDIA=google/gemini-3.5-flash-lite
# Model reasoning: on = better judgement but up to ~20 s per call; false = 3-4 s (testing, demo)
LLM_REASONING=true
LLM_TIMEOUT=60
DECIDE_THRESHOLD=0.7
ROUTE_THRESHOLD=0.6

# LangGraph checkpointer: Supabase direct or session-mode connection (not the transaction pooler)
DATABASE_URL=

# App
TELEGRAM_BOT_TOKEN=

SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Bluesky (per-business connection is still open; one account for now)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Resend
RESEND_API_KEY=
RESEND_FROM=

# Search and fetch (Keenable or DuckDuckGo fallback; Mark decides)
KEENABLE_API_KEY=

# Dashboard (served by the app process). DASHBOARD_URL is the public base of the links /dashboard sends.
PORT=8000
DASHBOARD_HOST=127.0.0.1
DASHBOARD_URL=http://localhost:8000

# Shared
LOG_LEVEL=INFO
